{
  "name": "toolbelt",
  "version": "1.0.0",
  "private": true,
  "description": "Private toolbox of everyday utilities that run in your browser. Offline PWA, nothing leaves your device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src scripts",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "croner": "10.0.1",
    "cronstrue": "3.38.0",
    "culori": "4.0.2",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "hash-wasm": "4.12.0",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "papaparse": "5.7.0",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "smol-toml": "1.9.1",
    "sql-formatter": "15.9.0",
    "turndown": "7.2.4",
    "ua-parser-js": "2.0.10",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/culori": "4.0.1",
    "@types/papaparse": "5.5.2",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2"
  }
}
